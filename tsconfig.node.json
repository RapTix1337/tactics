{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023"],
    // vite/client types import.meta.glob (bundled-migrations.ts) — the main
    // bundle is built by Vite via electron-vite, so the API is real there.
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/app/**/*",
    "src/modules/**/*",
    "src/shared/**/*",
    "tests/e2e/**/*",
    "drizzle.config.ts",
    "electron.vite.config.ts",
    "playwright.config.ts",
    "vitest.config.ts"
  ]
}
