{
  "name": "tactics",
  "version": "0.1.0",
  "private": true,
  "description": "TactiCS — open-source desktop companion app for Counter-Strike 2",
  "author": "RapTix1337",
  "license": "GPL-3.0",
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "prepare": "husky",
    "predev": "node scripts/ensure-native-abi.mjs electron",
    "dev": "electron-vite dev",
    "prestart": "node scripts/ensure-native-abi.mjs electron",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "db:generate": "drizzle-kit generate",
    "package:dir": "electron-builder --dir",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.neutral.json",
    "pretest": "node scripts/ensure-native-abi.mjs node",
    "test": "vitest run",
    "pretest:watch": "node scripts/ensure-native-abi.mjs node",
    "test:watch": "vitest",
    "pretest:e2e": "node scripts/ensure-native-abi.mjs electron",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:boundaries": "node scripts/verify-boundary-rules.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yaml,yml,html,css}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.0",
    "@playwright/test": "^1.61.1",
    "@rgrove/parse-xml": "^4.2.1",
    "@tailwindcss/vite": "4.3.2",
    "@tanstack/react-router": "1.170.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "electron": "43.0.0",
    "electron-builder": "^26.15.3",
    "electron-log": "^5.4.4",
    "electron-updater": "6.8.9",
    "electron-vite": "^5.0.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "lucide-react": "1.23.0",
    "prettier": "^3.9.4",
    "radix-ui": "1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.2",
    "tw-animate-css": "1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "vite": "^7.3.6",
    "vitest": "^4.1.9",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "dependencies": {
    "better-sqlite3": "github:WiseLibs/better-sqlite3#v12.11.2"
  }
}
